# מפתח Gemini API (חובה)
# קבל בחינם: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (מ-@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
